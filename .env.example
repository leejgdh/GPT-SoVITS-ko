# tts-service (GPT-SoVITS-ko) 로컬 실행 설정.
#
# 값이 사는 곳은 이 파일 하나다 — 코드와 config.yaml 에 기본값을 두지 않는다.
# 키가 없으면 시작할 때 어느 키인지 알리고 멈춘다.
# 컨테이너 실행은 이 파일을 읽지 않는다 — 저장소 루트 `.env` 를 compose 가 주입한다.
# `.env.example` 이 키 목록이다 (`cp .env.example .env` 후 값을 채운다).

# ── listen 주소 (로컬은 uvicorn 기본 포트. 다른 서비스와 겹치면 `serve --port`) ──
TTS_PORT=

# ── voice 자산 (프로젝트 루트 기준 상대경로) ──
TTS_VOICES_DIR=
# 학습 파이프라인 job 의 상태와 로그를 보관하는 폴더
TTS_JOBS_DIR=
# 기동 시 미리 올릴 voice. 비우면 올리지 않는다
TTS_DEFAULT_VOICE=
# 마지막 합성 이후 이 시간(초)이 지나면 모델을 내린다. 0 이면 내리지 않는다
TTS_MODEL_IDLE_UNLOAD_SECONDS=

# ── Voice Checker 분류 모델 ──
TTS_VOICE_CHECKER_MODEL=

LOG_LEVEL=
